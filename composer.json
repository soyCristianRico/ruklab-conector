{
    "name": "ruklab/connector",
    "description": "Conecta una web hecha a medida con la plataforma de Ruk Lab: lectura y edición de sus contenidos.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Ruk Lab",
            "homepage": "https://ruklab.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Ruklab\\Connector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ruklab\\Connector\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ruklab\\Connector\\ConnectorServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
